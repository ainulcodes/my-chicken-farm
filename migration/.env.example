# Salin file ini menjadi migration/.env lalu isi nilainya.
# Ambil dari: Supabase Dashboard -> Project Settings -> API

# URL project, contoh: https://abcdefgh.supabase.co
SUPABASE_URL=

# service_role key (RAHASIA — bypass RLS, hanya untuk script import lokal).
# JANGAN taruh key ini di frontend. File migration/.env sudah di-gitignore.
SUPABASE_SERVICE_ROLE_KEY=
