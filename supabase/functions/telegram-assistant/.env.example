# Salin hanya untuk pengujian lokal. Jangan commit file .env asli.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret
ALLOWED_TELEGRAM_USER_IDS=123456789

# Opsional. Tanpa ini, perintah deterministik tetap berjalan.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.8-flash

# SUPABASE_URL dan SUPABASE_SECRET_KEYS otomatis disediakan Supabase CLI/runtime.
# Jangan mencoba menambahkannya melalui `supabase secrets set` karena prefix
# SUPABASE_ dikelola oleh platform.
